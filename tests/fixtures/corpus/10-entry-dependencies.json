{
  "description": "entry variables bound in dependency order; a seed is neither overwritten nor evaluated",
  "pipeline": {
    "nodes": [
      {
        "id": "start",
        "type": "entry",
        "next": "end",
        "variables": {
          "label.$": "vars.name + ': ' + string(vars.total)",
          "total.$": "vars.price * vars.qty",
          "price": 10,
          "qty": 3,
          "name": "order"
        }
      },
      {
        "id": "end",
        "type": "terminal",
        "artifacts": [
          "label",
          "total"
        ]
      }
    ]
  },
  "runs": [
    {
      "name": "defaults",
      "expect": {
        "artifacts": {
          "label": "order: 30",
          "total": 30
        }
      }
    },
    {
      "name": "a seeded qty",
      "vars": {
        "qty": 5
      },
      "expect": {
        "artifacts": {
          "label": "order: 50",
          "total": 50
        }
      }
    },
    {
      "name": "a seeded total wins over its expression",
      "vars": {
        "total": 1
      },
      "expect": {
        "artifacts": {
          "label": "order: 1",
          "total": 1
        }
      }
    }
  ]
}
