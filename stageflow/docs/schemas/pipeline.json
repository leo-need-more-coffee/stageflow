{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageFlow Pipeline",
  "type": "object",
  "required": [
    "nodes"
  ],
  "properties": {
    "api_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry": {
      "description": "Id of the node execution starts from. Optional when the graph has a node of type 'entry' — that node is the entry point.",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "subpipelines": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/pipeline"
      },
      "default": {}
    },
    "types": {
      "description": "Named types: a structure (a mapping of field -> type, the ? suffix means optional; or {fields, strict}) or an alias expression. Expressions: string|int|float|number|bool|any|null, list<T>, map<T>, T|U, T?.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      },
      "default": {}
    },
    "variables": {
      "description": "Declared types of frame variables: {name: type}. Undeclared variables are not checked (gradual typing).",
      "$ref": "#/$defs/variable_declarations"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "pipeline": {
      "$ref": "#"
    },
    "variable_declarations": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "argument_bucket": {
      "description": "References into the frame: {argument_name: variable_name}. A list is sugar for copying under the same name. The .$ suffix on a key means the value is evaluated as CEL.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "arguments": {
      "type": "object",
      "properties": {
        "vars": {
          "$ref": "#/$defs/argument_bucket"
        },
        "const": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "description": "Mapping of the stage result onto variables. A bare key is a result field name -> a variable name. A key with .$ names the variable itself and its value is CEL (`vars` as of node entry and `output` are visible).",
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\W\\d]\\w*(\\.\\$)?$"
      },
      "additionalProperties": true
    },
    "expose": {
      "description": "Renaming or copying inside the frame without a stage: {'from_variable': 'to_variable'}.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[^\\W\\d]\\w*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^\\W\\d]\\w*$"
      }
    },
    "consume": {
      "description": "Variable names physically removed from the frame after this node.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "error_equals"
        ],
        "properties": {
          "error_equals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "interval_seconds": {
            "type": "number",
            "minimum": 0
          },
          "backoff_rate": {
            "type": "number",
            "minimum": 1
          },
          "max_delay_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "entry_variables": {
      "description": "Variables the pipeline starts with: {name: value}. The .$ suffix on a key means the value is evaluated as CEL. These are DEFAULTS: a name already present in the frame is not overwritten. Binding follows dependencies, so an expression may reference a sibling variable.",
      "type": "object",
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[^\\W\\d]\\w*(\\.\\$)?$"
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "description": "A graph node. The concrete schema is picked by 'type' through 'if/then' (an OpenAPI-style 'discriminator' does not work here: JSON Schema does not execute it, so the per-type schemas would never be applied).",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "entry"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/entry_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stage"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/stage_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "condition"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/condition_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "switch"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/switch_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "parallel"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/parallel_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "terminal"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/terminal_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subpipeline"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/subpipeline_node"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "try"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/try_node"
          }
        }
      ]
    },
    "entry_node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "entry"
        },
        "variables": {
          "$ref": "#/$defs/entry_variables"
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "stage_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "stage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "stage"
        },
        "stage": {
          "type": "string"
        },
        "arguments": {
          "$ref": "#/$defs/arguments"
        },
        "outputs": {
          "$ref": "#/$defs/outputs"
        },
        "consume": {
          "$ref": "#/$defs/consume"
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "condition_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "condition",
        "then"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "condition"
        },
        "condition": {
          "type": "string",
          "description": "CEL expression"
        },
        "then": {
          "type": "string"
        },
        "else": {
          "type": [
            "string",
            "null"
          ]
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "switch_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "cases"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "switch"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "when",
              "next"
            ],
            "properties": {
              "when": {
                "type": "string",
                "description": "CEL expression"
              },
              "next": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "parallel_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "branches"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "parallel"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "entry"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "entry": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "cancel_on_error": {
          "type": "boolean",
          "default": true
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "terminal_node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "terminal"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "subpipeline_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "subpipeline_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "subpipeline"
        },
        "subpipeline_id": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifact_outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "result_output": {
          "type": [
            "string",
            "null"
          ]
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "except_handler": {
      "type": "object",
      "required": [
        "error_equals",
        "next"
      ],
      "properties": {
        "error_equals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "next": {
          "type": "string"
        },
        "result_var": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "try_node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "body",
        "except"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "try"
        },
        "body": {
          "type": "string",
          "description": "Entry into the block body; the region is everything reachable from here but not from next"
        },
        "except": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/except_handler"
          }
        },
        "expose": {
          "$ref": "#/$defs/expose"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
